{
  "name": "a-society-runtime",
  "version": "0.1.0",
  "description": "Unified executable layer for the A-Society framework",
  "type": "module",
  "scripts": {
    "start": "tsx src/server/startup.ts",
    "typecheck": "tsc -b",
    "build:ui": "vite build",
    "build": "npm run typecheck && npm run build:ui",
    "lint": "eslint .",
    "lint:css": "stylelint \"ui/src/**/*.css\"",
    "check": "npm run lint && npm run lint:css && npm run typecheck && npm run build:ui && npm test",
    "test": "vitest run --config vitest.config.ts"
  },
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.36.0",
    "@modelcontextprotocol/sdk": "1.29.0",
    "@opentelemetry/api": "1.7.0",
    "@opentelemetry/context-async-hooks": "^1.30.1",
    "@opentelemetry/exporter-logs-otlp-http": "^0.47.0",
    "@opentelemetry/exporter-metrics-otlp-http": "^0.47.0",
    "@opentelemetry/exporter-trace-otlp-http": "^0.47.0",
    "@opentelemetry/resources": "^1.30.1",
    "@opentelemetry/sdk-node": "^0.47.0",
    "@opentelemetry/sdk-trace-base": "^1.30.1",
    "@opentelemetry/semantic-conventions": "^1.40.0",
    "dotenv": "^16.0.0",
    "express": "^4.21.2",
    "js-yaml": "^4.1.0",
    "openai": "^4.0.0",
    "ws": "^8.18.3",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@dagrejs/dagre": "^3.0.0",
    "@eslint/js": "^9.39.4",
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "@fontsource/ibm-plex-sans": "^5.3.0",
    "@fontsource/source-serif-4": "^5.3.0",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/express": "^5.0.1",
    "@types/js-yaml": "^4.0.0",
    "@types/node": "^20.0.0",
    "@types/react": "^19.1.2",
    "@types/react-dom": "^19.1.2",
    "@types/ws": "^8.5.14",
    "@vitejs/plugin-react": "^4.4.1",
    "@xyflow/react": "^12.6.4",
    "eslint": "^9.39.4",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.5.0",
    "jsdom": "^29.1.1",
    "lucide-react": "^1.25.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-markdown": "^10.1.0",
    "react-resizable-panels": "^4.12.2",
    "rehype-highlight": "^7.0.2",
    "remark-gfm": "^4.0.1",
    "stylelint": "^17.14.0",
    "tsx": "^4.0.0",
    "typescript": "^5.0.0",
    "typescript-eslint": "^8.59.0",
    "vite": "^6.3.5",
    "vitest": "^3.2.4",
    "vitest-axe": "^0.1.0"
  }
}
