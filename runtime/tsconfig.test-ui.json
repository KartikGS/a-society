{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "strict": true,
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "skipLibCheck": true,
    "composite": true,
    "declaration": true,
    "emitDeclarationOnly": true,
    "rootDir": ".",
    "outDir": "./dist/test-ui",
    "tsBuildInfoFile": "./dist/tsconfig.test-ui.tsbuildinfo",
    "isolatedModules": true,
    "types": []
  },
  "include": ["test/ui/components/**/*"],
  "references": [
    { "path": "./tsconfig.shared.json" },
    { "path": "./tsconfig.app.json" }
  ]
}
